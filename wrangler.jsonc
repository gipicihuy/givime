{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "givime",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": [
    // Enable Node.js API
    "nodejs_compat",
    // Allow fetching external URLs (dipake buat proxy ke karanime.com)
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "givime"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
